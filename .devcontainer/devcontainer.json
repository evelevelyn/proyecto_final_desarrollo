{
  "name": "EcoTij · Python Flask",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "EcoTij · Flask",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --disable-pip-version-check -r requirements.txt",
  "postStartCommand": "nohup .venv/bin/python app.py > /tmp/ecotij-flask.log 2>&1 < /dev/null &"
}
